using System.Diagnostics;
using System.Reflection;
using System.Text.Json;

foreach (var path in args)
{
    var assemblyName = AssemblyName.GetAssemblyName(path);
    var fileVersion = FileVersionInfo.GetVersionInfo(path);
    Console.WriteLine("PACKAGE_IDENTITY:" + JsonSerializer.Serialize(new
    {
        path,
        name = assemblyName.Name,
        assemblyVersion = assemblyName.Version?.ToString() ?? string.Empty,
        fileVersion = fileVersion.FileVersion ?? string.Empty,
        informationalVersion = fileVersion.ProductVersion ?? string.Empty,
    }));
}
